<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action to filter and show ONLY Low Stock products -->
    <record id="action_stocksense_low_stock" model="ir.actions.act_window">
        <field name="name">Low Stock Items</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('is_low_stock', '=', True)]</field>
        <field name="context">{'search_default_filter_to_sell': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                All stock levels are optimal!
            </p>
            <p>
                Products will appear here when their quantity falls below your set threshold.
            </p>
        </field>
    </record>

    <!-- Action for Total Products in Stock -->
    <record id="action_stocksense_all_products" model="ir.actions.act_window">
        <field name="name">Total Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('type', '=', 'product')]</field>
    </record>
</odoo>