<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_stocksense_low_stock" model="ir.actions.act_window">
        <field name="name">Low Stock Items</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('is_low_stock', '=', True)]</field>
    </record>

    <record id="action_stocksense_all_products" model="ir.actions.act_window">
        <field name="name">Total Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('type', '=', 'product')]</field>
    </record>
</odoo>