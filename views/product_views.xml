<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the default product form to add StockSense fields -->
    <record id="view_product_template_form_stocksense" model="ir.ui.view">
        <field name="name">product.template.form.stocksense</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add custom threshold fields inside the Inventory tab -->
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="StockSense Alerts">
                    <field name="low_stock_threshold" string="Alert Threshold"/>
                    <field name="is_low_stock" readonly="1" widget="boolean_toggle"/>
                </group>
            </xpath>
            
            <!-- Highlight Name, SKU, and Category as requested in the brief -->
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">SKU / Code</attribute>
            </xpath>
        </field>
    </record>
</odoo>