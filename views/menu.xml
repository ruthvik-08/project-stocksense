<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root App Menu Item -->
    <menuitem id="menu_stocksense_root" 
              name="StockSense" 
              sequence="1"/>

    <!-- Top Level Menus -->
    <menuitem id="menu_stocksense_dashboard" 
              name="Dashboard" 
              parent="menu_stocksense_root" 
              sequence="10"/>
              
    <menuitem id="menu_stocksense_products_main" 
              name="Products" 
              parent="menu_stocksense_root" 
              sequence="20"/>
              
    <menuitem id="menu_stocksense_operations_main" 
              name="Operations" 
              parent="menu_stocksense_root" 
              sequence="30"/>

    <!-- 1. Dashboard Sub-menus (KPIs) -->
    <menuitem id="menu_dashboard_total_products" 
              name="Total Products in Stock" 
              parent="menu_stocksense_dashboard" 
              action="action_stocksense_all_products" 
              sequence="10"/>
              
    <menuitem id="menu_dashboard_low_stock" 
              name="Low Stock Alerts" 
              parent="menu_stocksense_dashboard" 
              action="action_stocksense_low_stock" 
              sequence="20"/>

    <!-- 2. Products Navigation (Create products, Categories, Reordering) -->
    <menuitem id="menu_products_list" 
              name="Products" 
              parent="menu_stocksense_products_main" 
              action="stock.stock_product_normal_action" 
              sequence="10"/>
              
    <menuitem id="menu_product_categories" 
              name="Product Categories" 
              parent="menu_stocksense_products_main" 
              action="product.product_category_action_form" 
              sequence="20"/>
              
    <menuitem id="menu_product_reordering" 
              name="Reordering Rules" 
              parent="menu_stocksense_products_main" 
              action="stock.action_orderpoint" 
              sequence="30"/>
</odoo>